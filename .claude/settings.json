{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/remind-update-trackers.sh\"",
            "timeout": 15,
            "statusMessage": "Checking status trackers…"
          }
        ]
      }
    ]
  }
}
